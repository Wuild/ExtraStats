<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="ExtraStatsFrameCategoryTemplate" virtual="true" enableMouse="true">
        <Size x="207" y="29"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" file="Interface\Buttons\WHITE8X8" alpha="0.72">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="0.055" g="0.075" b="0.10"/>
                </Texture>
                <Texture parentKey="Accent" file="Interface\Buttons\WHITE8X8">
                    <Size x="3"/>
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMLEFT"/>
                    </Anchors>
                    <Color r="0.82" g="0.62" b="0.20"/>
                </Texture>
                <Texture parentKey="Divider" file="Interface\Buttons\WHITE8X8" alpha="0.6">
                    <Size y="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="3"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="0.38" g="0.30" b="0.16"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Title" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="30" y="0"/>
                        <Anchor point="RIGHT" x="-24" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Hover" file="Interface\Buttons\WHITE8X8" alpha="0.08" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="1" g="0.82" b="0.35"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="CollapseButton">
                <Size x="18" y="18"/>
                <Anchors>
                    <Anchor point="LEFT" x="6" y="0"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-MinusButton-Up"/>
                <PushedTexture file="Interface\Buttons\UI-MinusButton-Down"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button parentKey="UpButton">
                <Size x="15" y="15"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-1"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Up"/>
                <PushedTexture file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button parentKey="DownButton">
                <Size x="15" y="15"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-5" y="1"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Up">
                    <TexCoords left="0" right="1" top="1" bottom="0"/>
                </NormalTexture>
                <PushedTexture file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Down">
                    <TexCoords left="0" right="1" top="1" bottom="0"/>
                </PushedTexture>
                <DisabledTexture file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Disabled">
                    <TexCoords left="0" right="1" top="1" bottom="0"/>
                </DisabledTexture>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                self.Title:SetText(self.titleText);
                <!--                self:RegisterForDrag("LeftButton");-->
                self.expanded = true
            </OnLoad>
            <OnEnter>
                self.Hover:Show();
            </OnEnter>
            <OnLeave>
                self.Hover:Hide();
            </OnLeave>
        </Scripts>
    </Frame>

    <Frame name="ExtraStatsCharacterStatFrameTemplate" virtual="true" enableMouse="true">
        <Size x="207" y="21"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Surface" file="Interface\Buttons\WHITE8X8" alpha="0.34">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="0.035" g="0.045" b="0.06"/>
                </Texture>
                <Texture parentKey="Background" file="Interface\Buttons\WHITE8X8" alpha="0.12">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="0.45" g="0.55" b="0.68"/>
                </Texture>
                <Texture parentKey="Divider" file="Interface\Buttons\WHITE8X8" alpha="0.12">
                    <Size y="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="8"/>
                        <Anchor point="BOTTOMRIGHT" x="-8"/>
                    </Anchors>
                    <Color r="0.72" g="0.72" b="0.72"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="10" y="0"/>
                        <Anchor point="RIGHT" x="-76" y="0"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Value" inherits="GameFontHighlightSmall" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="RIGHT" x="-12" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Hover" file="Interface\Buttons\WHITE8X8" alpha="0.10" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="1" g="0.82" b="0.35"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter>
                self.Hover:Show();
                if self.onEnter ~= nil then
                self.onEnter(self);
                else
                PaperDollStatTooltip(self);
                end
            </OnEnter>
            <OnLeave>
                self.Hover:Hide();
                GameTooltip_Hide();
            </OnLeave>
            <OnLoad>
                if (STATFRAME_STATTEXT_FONT_OVERRIDE) then
                self.Value:SetFontObject(STATFRAME_STATTEXT_FONT_OVERRIDE);
                end
            </OnLoad>
            <OnUpdate>
                if self.onUpdate ~= nil then
                self.onUpdate(self);
                end
            </OnUpdate>
        </Scripts>
    </Frame>

    <Frame name="ExtraStatsRoleIconFrameTemplate" virtual="true" enableMouse="true">
        <Size x="26" y="26"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <ScrollFrame name="ExtraStatsScrollFrame" inherits="UIPanelScrollFrameTemplate" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentTop" parentKey="Top" file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
                    <Size x="31" y="256"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentScrollBarScrollUpButton" relativePoint="TOPLEFT"
                                x="-8" y="5"/>
                    </Anchors>
                    <TexCoords left="0" right="0.484375" top="0" bottom="1.0"/>
                </Texture>
                <Texture name="$parentBottom" parentKey="Bottom"
                         file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
                    <Size x="31" y="106"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeTo="$parentScrollBarScrollDownButton"
                                relativePoint="BOTTOMLEFT" x="-8" y="-2"/>
                    </Anchors>
                    <TexCoords left="0.515625" right="1.0" top="0" bottom="0.4140625"/>
                </Texture>
                <Texture parentKey="Middle" file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Top"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Bottom"/>
                    </Anchors>
                    <TexCoords left="0" right="0.484375" top="0.3640625" bottom="1"/>
                </Texture>
            </Layer>
        </Layers>
    </ScrollFrame>

    <Button name="CharacterFrameExpandButtonTemplate" virtual="true">
        <Size x="32" y="32"/>
        <Anchors>
            <Anchor point="TOPRIGHT" relativeTo="CharacterTrinket1Slot" x="-2" y="-39"/>
        </Anchors>
        <Scripts>
            <OnLoad>
                self:SetFrameLevel(self:GetParent():GetFrameLevel() + 2);
            </OnLoad>
            <OnClick>

            </OnClick>
            <OnEnter>
                GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
                if (CharacterFrame.db.char.enabled) then
                GameTooltip:SetText(HIGHLIGHT_FONT_COLOR_CODE..self.collapseTooltip..FONT_COLOR_CODE_CLOSE);
                else
                GameTooltip:SetText(HIGHLIGHT_FONT_COLOR_CODE..self.expandTooltip..FONT_COLOR_CODE_CLOSE);
                end
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide();
            </OnLeave>
        </Scripts>
        <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
        <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
        <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
        <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
    </Button>


</Ui>
